include $(APPDIR)/tools/Rust.mk

ifneq ($(CONFIG_FHRE_RUST),)
CONFIGURED_APPS += $(APPDIR)/fhre/rust

# Rust library path: target/<target>/<profile>/lib<crate>.a
# The path is dynamically determined by the target and profile
RUST_TARGET := $(strip $(call RUST_TARGET_TRIPLE))
EXTRA_LIBS += $(APPDIR)/fhre/rust/target/$(RUST_TARGET)/$(if $(CONFIG_DEBUG_FULLOPT),release,debug)/libfhre.a
endif
