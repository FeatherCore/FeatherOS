#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "RA8P Configuration Options"

choice
	prompt "RA8P Chip Selection"
	default ARCH_CHIP_R7KA8P1KFLCAC
	depends on ARCH_CHIP_RA8P

config ARCH_CHIP_R7KA8P1KFLCAC
	bool "R7KA8P1KFLCAC (RA8P1)"
	select ARCH_CORTEXM85
	select ARCH_HAVE_FPU
	select ARCH_HAVE_MPU
	select ARM_HAVE_MPU_UNIFIED
	select ARM_HAVE_MVE
	select ARMV8M_HAVE_ICACHE
	select ARMV8M_HAVE_DCACHE
	select ARMV8M_SYSTICK
	help
	  Renesas RA8P1 Series (Cortex-M85)
	  - Up to 1 GHz ARM Cortex-M85
	  - ARMv8.1-M Mainline architecture
	  - DSP, MVE-F, FPU, I/D Cache
	  - Dual Core (CM85 + CM33)
	  - Optional Ethos-U55 NPU
	  - MIPI DSI/CSI support

endchoice # RA8P Chip Selection

config RA8P_DUAL_CORE
	bool "Enable dual-core support"
	default y if ARCH_CHIP_R7KA8P1KFLCAC
	depends on ARCH_CHIP_R7KA8P1KFLCAC
	help
	  Enable support for dual-core configuration (Cortex-M85 + Cortex-M33)

config RA8P_MIPI_DSI
	bool "Enable MIPI DSI support"
	default y if ARCH_CHIP_R7KA8P1KFLCAC
	depends on ARCH_CHIP_R7KA8P1KFLCAC
	help
	  Enable MIPI DSI/CSI display interface support

config RA8P_NPU_ETHOS_U55
	bool "Enable Ethos-U55 NPU support"
	default n
	depends on ARCH_CHIP_R7KA8P1KFLCAC
	help
	  Enable Arm Ethos-U55 NPU support for AI/ML operations

menu "RA8P Peripheral Support"

config RA8P_HAVE_SCI_B_UART
	bool
	default y

config RA8P_HAVE_SPI_B
	bool
	default y

config RA8P_HAVE_IIC
	bool
	default y

config RA8P_HAVE_GPT_PWM
	bool
	default y

config RA8P_HAVE_USBFS
	bool
	default y

config RA8P_HAVE_USBHS
	bool
	default y

config RA8P_HAVE_CANFD
	bool
	default y

config RA8P_HAVE_SDHC
	bool
	default y

config RA8P_HAVE_RTC
	bool
	default y

config RA8P_HAVE_WDT
	bool
	default y

config RA8P_HAVE_GLCDC
	bool
	default y

config RA8P_HAVE_MIPI_DSI
	bool
	default y if RA8P_MIPI_DSI
	default n

config RA8P_HAVE_I3C
	bool
	default y

config RA8P_HAVE_SDRAMC
	bool
	default y

config RA8P_HAVE_DMA
	bool
	default y

config RA8P_HAVE_NPU
	bool
	default y if RA8P_NPU_ETHOS_U55
	default n

