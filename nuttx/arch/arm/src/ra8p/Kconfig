comment "Power Management Configuration"

config RA8P_POWER
	bool "Power Management"
	default y
	help
	  Enable power management support including sleep, standby, and deep standby modes.

endmenu # RA8P Peripheral Support

config RA8P_NR_IRQS
	int "Number of peripheral interrupts"
	default 96
	depends on ARCH_CHIP_RA8P

config RA8P_ROM_SIZE
	hex "Code MRAM/Flash size"
	default 0x100000
	depends on ARCH_CHIP_R7KA8P1KFLCAC
	help
	  Code MRAM and Flash size for RA8P1

config RA8P_PACKAGE_TYPE
	int "Package type"
	range 1 3
	default 2
	depends on ARCH_CHIP_R7KA8P1KFLCAC
	help
	  Package type:
	  1 -> AB: LFBGA 224 pins
	  2 -> AC: LFBGA 289 pins
	  3 -> AJ: LFBGA 303 pins

config RA8P_NUM_CORES
	int "Number of cores"
	range 1 2
	default 2
	depends on ARCH_CHIP_R7KA8P1KFLCAC
	help
	  Number of SoC cores (CM85 + CM33)
