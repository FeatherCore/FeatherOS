	int "USART3 Baud Rate"
	default 115200
	depends on STM32N6_UART3_SERIALDRIVER

config STM32N6_UART4
	bool "Enable UART4"
	default n

config STM32N6_UART4_SERIALDRIVER
	bool "UART4 serial driver"
	default n
	depends on STM32N6_UART4

config STM32N6_UART4_BAUD
	int "UART4 Baud Rate"
	default 115200
	depends on STM32N6_UART4_SERIALDRIVER

config STM32N6_UART5
