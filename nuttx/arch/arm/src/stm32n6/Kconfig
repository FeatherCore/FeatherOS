comment "STMicroelectronics STM32N6 Configuration"

if ARCH_CHIP_STM32N6

config ARCH_CHIP_STM32N6
	bool
	default n

config ARCH_CHIP_STM32N657XX
	bool "STM32N657xx"
	select ARCH_CHIP_STM32N6
	select ARCH_CORTEXM55
	select ARCH_HAVE_MPU
	select ARM_HAVE_MPU_UNIFIED
	select ARCH_HAVE_FPU
	select ARMV8M_HAVE_ICACHE
	select ARMV8M_HAVE_DCACHE
	select ARM_HAVE_DSP
	select ARM_HAVE_MVE
	select ARCH_ARMV8M
	---help---
		STMicroelectronics STM32N657xx (ARM Cortex-M55).
		ARMv8.1-M Mainline with DSP, MVE, FPU, I/D Cache, TrustZone, RIF.

if ARCH_CHIP_STM32N6

comment "STM32N6 Core Configuration"

config ARMV8M_HAVE_ICACHE
	bool
	default y

config ARMV8M_HAVE_DCACHE
	bool
	default y

config ARMV8M_DCACHE_LINE_SIZE
	int "D-Cache line size"
	default 32
	depends on ARMV8M_HAVE_DCACHE

config ARMV8M_ICACHE_LINE_SIZE
	int "I-Cache line size"
	default 32
	depends on ARMV8M_HAVE_ICACHE

comment "STM32N6 Peripherals"

config STM32N6_NPU
	bool "Enable Neural-ART NPU"
	default y
	---help---
		Enable the Neural-ART neural network accelerator (NPU).
		The NPU provides hardware acceleration for neural network inference.

config STM32N6_NPU_CACHE
	bool "Enable NPU Cache (CACHEAXI)"
	default y
	depends on STM32N6_NPU
	---help---
		Enable the NPU cache for improved performance.
		The CACHEAXI is required for optimal NPU operation.

config STM32N6_RIF
	bool "Enable Resource Isolation Framework (RIF)"
	default y
	---help---
		Enable the Resource Isolation Framework for hardware-based
		resource partitioning and security.

config STM32N6_RIF_OPEN
	bool "Configure RIF with full access"
	default y
	depends on STM32N6_RIF
	---help---
		Configure the Resource Isolation Framework to allow full access
		from the secure world to all SoC resources.

config STM32N6_LTDC
	bool "Enable LCD-TFT Display Controller (LTDC)"
	default n
	---help---
		Enable the LCD-TFT Display Controller for graphical output.

config STM32N6_DCMIPP
	bool "Enable Digital Camera Interface (DCMIPP)"
	default n
	---help---
		Enable the Digital Camera Interface Parallel Processor.

config STM32N6_ETH
	bool "Enable Ethernet Controller"
	default n
	---help---
		Enable the Ethernet MAC controller.

config STM32N6_USB
	bool "Enable USB OTG HS"
	default n
	---help---
		Enable USB OTG High Speed controllers.

config STM32N6_XSPI
	bool "Enable Octo-SPI (XSPI)"
	default n
	---help---
		Enable the Octo-SPI interface for external memory.

config STM32N6_JPEG
	bool "Enable JPEG Codec"
	default n
	---help---
		Enable the JPEG hardware codec.

config STM32N6_VENC
	bool "Enable Video Encoder (VENC)"
	default n
	---help---
		Enable the video encoder for hardware encoding.

config STM32N6_SDMMC
	bool "Enable SDMMC controllers"
	default n
	---help---
		Enable SD/MMC card controllers.

config STM32N6_DMA2D
	bool "Enable 2D Graphics Accelerator (DMA2D)"
	default n
	---help---
		Enable the 2D graphics acceleration engine.

config STM32N6_GPIO
	bool "Enable GPIO support"
	default y
	---help---
		Enable GPIO driver support.

config STM32N6_UART
	bool "Enable UART/USART support"
	default y
	---help---
		Enable UART/USART serial driver support.

if STM32N6_UART

config STM32N6_UART1
	bool "Enable USART1"
	default n

config STM32N6_UART1_SERIALDRIVER
	bool "USART1 serial driver"
	default n
	depends on STM32N6_UART1

config STM32N6_UART1_BAUD
	int "USART1 Baud Rate"
	default 115200
	depends on STM32N6_UART1_SERIALDRIVER

config STM32N6_UART2
	bool "Enable USART2"
	default n

config STM32N6_UART2_SERIALDRIVER
	bool "USART2 serial driver"
	default n
	depends on STM32N6_UART2

