	int "PLL4 P1 divider"
	default 2
	range 1 128

config STM32N6_PLL4_P2
	int "PLL4 P2 divider"
	default 2
	range 1 128

comment "STM32N6 Bus Prescalers"

config STM32N6_AHB_PRESCALER
	int "AHB prescaler"
	default 1
	range 1 512
	---help---
		AHB bus prescaler value.

config STM32N6_APB1_PRESCALER
	int "APB1 prescaler"
	default 1
	range 1 16
	---help---
		APB1 bus prescaler value.

config STM32N6_APB2_PRESCALER
	int "APB2 prescaler"
	default 1
	range 1 16
	---help---
		APB2 bus prescaler value.

config STM32N6_APB4_PRESCALER
	int "APB4 prescaler"
	default 1
	range 1 16
	---help---
		APB4 bus prescaler value.

config STM32N6_APB5_PRESCALER
	int "APB5 prescaler"
	default 1
	range 1 16
	---help---
		APB5 bus prescaler value.

comment "STM32N6 Voltage Scaling"

config STM32N6_VOS_SCALE
	prompt "Voltage scaling"
	default "SCALE0"
	choices "SCALE0" "SCALE1" "SCALE2"
	---help---
		Voltage scaling for power optimization.
		SCALE0 = highest performance, SCALE2 = lowest power.

comment "STM32N6 Additional Features"

config STM32N6_TIMERS
	bool "Enable TIM timer support"
	default y
	---help---
		Enable basic TIM timer support.

config STM32N6_EXTI
	bool "Enable EXTI interrupt support"
	default y
	---help---
		Enable External Interrupt/Event Controller support.

config STM32N6_HSEM
	bool "Enable Hardware Semaphore (HSEM)"
	default y
	---help---
		Enable Hardware Semaphore for multiprocessor synchronization.

config STM32N6_SYSCLK_FREQUENCY
	int "System clock frequency in Hz"
	default 64000000
	---help---
		System clock (SYSCLK) frequency in Hz.
		Default is 64MHz from HSI.

config STM32N6_HCLK_FREQUENCY
	int "AHB clock frequency in Hz"
	default 64000000
	---help---
		AHB bus clock (HCLK) frequency in Hz.
		Default matches SYSCLK.

config STM32N6_LPTIM
	bool "Enable Low-Power Timer (LPTIM)"
	default y
	---help---
		Enable Low-Power Timer support. LPTIMs continue to operate in low-power modes
		and provide timing services while minimizing power consumption.

config STM32N6_FLASH
	bool "Enable Flash memory controller"
	default y
	---help---
		Enable Flash memory controller for programming and erasing operations.
		Required for bootloader and flash-based storage operations.

config STM32N6_PWR
	bool "Enable Power Management Unit (PWR)"
	default y
	---help---
		Enable Power Management Unit for voltage scaling, power modes,
		and low-power operation control.

config STM32N6_WWDG
	bool "Enable Window Watchdog (WWDG)"
	default n
	---help---
		Enable Window Watchdog for enhanced system reliability.
		Provides a safety mechanism that requires timely refreshes within a window.

config STM32N6_IWDG
	bool "Enable Independent Watchdog (IWDG)"
	default y
	---help---
		Enable Independent Watchdog for system reliability.
		Provides a safety mechanism that requires periodic refreshes.

config STM32N6_FDCAN
	bool "Enable CAN-FD support"
	default n
	---help---
		Enable FDCAN controllers (CAN-FD protocol support).
		Provides CAN-FD protocol support with flexible data rate.

endif # ARCH_CHIP_STM32N6

endif # ARCH_CHIP_STM32N6
