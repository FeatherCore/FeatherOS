	default n

config STM32N6_UART5_SERIALDRIVER
	bool "UART5 serial driver"
	default n
	depends on STM32N6_UART5

config STM32N6_UART5_BAUD
	int "UART5 Baud Rate"
	default 115200
	depends on STM32N6_UART5_SERIALDRIVER

config STM32N6_UART6
	bool "Enable USART6"
	default n

config STM32N6_UART6_SERIALDRIVER
	bool "USART6 serial driver"
	default n
	depends on STM32N6_UART6

config STM32N6_UART6_BAUD
	int "USART6 Baud Rate"
	default 115200
	depends on STM32N6_UART6_SERIALDRIVER

endif # STM32N6_UART

config STM32N6_SPI
	bool "Enable SPI support"
	default n
	---help---
		Enable SPI driver support.

config STM32N6_I2C
	bool "Enable I2C support"
	default n
	---help---
		Enable I2C driver support.

config STM32N6_DMA
	bool "Enable DMA support"
	default n
	---help---
		Enable DMA driver support.

config STM32N6_ADC
	bool "Enable ADC support"
	default n
	---help---
		Enable ADC driver support.

comment "STM32N6 Memory Configuration"

config STM32N6_AXISRAM1
	bool "Enable AXISRAM1 (512KB)"
	default y
	---help---
		Enable AXISRAM1 bank. Default 512KB at 0x34000000.

config STM32N6_AXISRAM2
	bool "Enable AXISRAM2 (512KB)"
	default y
	---help---
		Enable AXISRAM2 bank. Default 512KB at 0x34180000.

config STM32N6_AXISRAM3
	bool "Enable AXISRAM3 (448KB)"
	default n
	---help---
		Enable AXISRAM3 bank via RAMCFG.

config STM32N6_AXISRAM4
	bool "Enable AXISRAM4 (448KB)"
	default n
	---help---
		Enable AXISRAM4 bank via RAMCFG.

config STM32N6_AXISRAM5
	bool "Enable AXISRAM5 (448KB)"
	default n
	---help---
		Enable AXISRAM5 bank via RAMCFG.

config STM32N6_AXISRAM6
	bool "Enable AXISRAM6 (448KB)"
	default n
	---help---
		Enable AXISRAM6 bank via RAMCFG.

comment "STM32N6 Clock Configuration"

config STM32N6_HSI_FREQUENCY
	int "HSI frequency in Hz"
	default 64000000
	---help---
		Internal HSI oscillator frequency. Default is 64 MHz.

config STM32N6_HSE_FREQUENCY
	int "HSE frequency in Hz"
	default 48000000
	---help---
		External HSE oscillator frequency. Default is 48 MHz.

config STM32N6_LSI_FREQUENCY
	int "LSI frequency in Hz"
	default 32000
	---help---
		Internal LSI oscillator frequency. Default is 32 kHz.

config STM32N6_LSE_FREQUENCY
	int "LSE frequency in Hz"
	default 32768
	---help---
		External LSE oscillator frequency. Default is 32.768 kHz.

config STM32N6_HSE_BYPASS
	bool "HSE crystal oscillator bypass"
	default n
	---help---
		Enable HSE bypass mode for external clock input.

config STM32N6_HSE_DIV2
	bool "Enable HSE/2 output"
	default n
	---help---
		Enable HSE divided by 2 output.

config STM32N6_LSE_BYPASS
	bool "LSE crystal oscillator bypass"
	default n
	---help---
		Enable LSE bypass mode for external clock input.

config STM32N6_LSE_DRIVING
	int "LSE driving capability (0-3)"
	default 2
	range 0 3
	---help---
		LSE oscillator driving capability. 0=low, 3=high.

comment "STM32N6 PLL Configuration"

config STM32N6_PLL1_SOURCE
	prompt "PLL1 source clock"
	default "HSI"
	choices "HSI" "HSE" "MSI"
	---help---
		PLL1 source clock selection.

config STM32N6_PLL1_M
	int "PLL1 M divider"
	default 2
	range 1 63
	---help---
		PLL1 M divider value.

config STM32N6_PLL1_N
	int "PLL1 N multiplier"
	default 100
	range 4 512
	---help---
		PLL1 N multiplier value.

config STM32N6_PLL1_P1
	int "PLL1 P1 divider"
	default 2
	range 1 128
	---help---
		PLL1 P1 output divider.

config STM32N6_PLL1_P2
	int "PLL1 P2 divider"
	default 2
	range 1 128
	---help---
		PLL1 P2 output divider.

config STM32N6_PLL2_SOURCE
	prompt "PLL2 source clock"
	default "HSI"
	choices "HSI" "HSE" "MSI"
	---help---
		PLL2 source clock selection.

config STM32N6_PLL2_M
	int "PLL2 M divider"
	default 2
	range 1 63

config STM32N6_PLL2_N
	int "PLL2 N multiplier"
	default 100
	range 4 512

config STM32N6_PLL2_P1
	int "PLL2 P1 divider"
	default 2
	range 1 128

config STM32N6_PLL2_P2
	int "PLL2 P2 divider"
	default 2
	range 1 128

config STM32N6_PLL3_SOURCE
	prompt "PLL3 source clock"
	default "HSI"
	choices "HSI" "HSE" "MSI"
	---help---
		PLL3 source clock selection.

config STM32N6_PLL3_M
	int "PLL3 M divider"
	default 2
	range 1 63

config STM32N6_PLL3_N
	int "PLL3 N multiplier"
	default 100
	range 4 512

config STM32N6_PLL3_P1
	int "PLL3 P1 divider"
	default 2
	range 1 128

config STM32N6_PLL3_P2
	int "PLL3 P2 divider"
	default 2
	range 1 128

config STM32N6_PLL4_SOURCE
	prompt "PLL4 source clock"
	default "HSI"
	choices "HSI" "HSE" "MSI"
	---help---
		PLL4 source clock selection.

config STM32N6_PLL4_M
	int "PLL4 M divider"
	default 2
	range 1 63

