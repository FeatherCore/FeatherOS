#
# STM32N6570-DK Board Configuration for FeatherOS/NuttX
#

CONFIG_ARCH_CHIP_STM32N657XX=y
CONFIG_ARCH_ARMV8M=y
CONFIG_ARCH_FPU=y
CONFIG_ARM_MPU=y

# System Clock Configuration
CONFIG_STM32N6_HSI_FREQUENCY=64000000
CONFIG_STM32N6_HSE_FREQUENCY=48000000
CONFIG_STM32N6_SYSCLK_FREQUENCY=64000000
CONFIG_STM32N6_AHB_PRESCALER=1
CONFIG_STM32N6_APB1_PRESCALER=1
CONFIG_STM32N6_APB2_PRESCALER=1
CONFIG_STM32N6_APB4_PRESCALER=1
CONFIG_STM32N6_APB5_PRESCALER=1
CONFIG_STM32N6_VOS_SCALE=SCALE0

# UART Configuration
CONFIG_STM32N6_UART=y
CONFIG_STM32N6_UART1=y
CONFIG_STM32N6_UART1_SERIALDRIVER=y
CONFIG_STM32N6_UART1_BAUD=115200
CONFIG_STM32N6_UART2=y
CONFIG_STM32N6_UART2_SERIALDRIVER=y
CONFIG_STM32N6_UART2_BAUD=115200

# GPIO Configuration
CONFIG_STM32N6_GPIO=y

# Timer Configuration
CONFIG_STM32N6_TIMERS=y

# EXTI Configuration
CONFIG_STM32N6_EXTI=y

# HSEM Configuration
CONFIG_STM32N6_HSEM=y

# NPU Configuration
CONFIG_STM32N6_NPU=y
CONFIG_STM32N6_NPU_CACHE=y

# RIF Configuration
CONFIG_STM32N6_RIF=y
CONFIG_STM32N6_RIF_OPEN=y

# Memory Configuration
CONFIG_STM32N6_AXISRAM1=y
CONFIG_STM32N6_AXISRAM2=y
CONFIG_STM32N6_AXISRAM3=n
CONFIG_STM32N6_AXISRAM4=n
CONFIG_STM32N6_AXISRAM5=n
CONFIG_STM32N6_AXISRAM6=n

# Cache Configuration
CONFIG_ARMV8M_DCACHE=y
CONFIG_ARMV8M_ICACHE=y

# Serial Driver
CONFIG_SERIAL=y
CONFIG_UART_SERIALDRIVER=y
CONFIG_SERIAL_CONSOLE=y

# System Configuration
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_SCHED_CPULOAD=y
CONFIG_USEC_PER_TICK=1000
CONFIG_SCHED_WORKQUEUE=y

# Debug Configuration
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_ERRORS=y
CONFIG_DEBUG_WARNINGS=y

# Build Configuration
CONFIG_BUILD_PROTECTED=n
CONFIG_NXFLAT=n
CONFIG_HAVE_RAMFUNCS=y
