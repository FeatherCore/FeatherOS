# Minimal config for testing ESP32 WiFi driver compilation
# This enables the necessary options for ESP32 cfg80211 driver

# Architecture (use sim:fhre as base)
CONFIG_ARCH=sIM
CONFIG_ARCH_BOARD="sim:fhre"
CONFIG_ARCH_CHIP="sim"
CONFIG_ARCH_CHIP_SIM=y

# Basic OS features
CONFIG_SCHED_FFIFO=y
CONFIG_SCHED_HPWORK=y
CONFIG_PREALLOC_TIMERS=4
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_SIG_DEFAULT=y
CONFIG_START_DAY=6
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2011

# Memory management
CONFIG_MM_REGIONS=1
CONFIG_MM_SMALL_ALLOC=y

# Console
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_UART0_SERIAL_CONSOLE_DAYPRI=1
CONFIG_UART0_SERIAL_CONSOLE_DAYSIZ=256

# Networking
CONFIG_NET=y
CONFIG_NET_SKBUFFERS=1024
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_DBUTILS_CJSON=y
CONFIG_NETUTILS_IPERF=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_WIRELESS_IOCTL=y

# Wireless subsystem
CONFIG_WIRELESS=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_NL80211=y
CONFIG_NL80211_MAX_WIPHY=4
CONFIG_NL80211_MAX_INTERFACES=8
CONFIG_CFG80211=y
CONFIG_CFG80211_MAX_WIPHY=4
CONFIG_CFG80211_MAX_BSS=64
CONFIG_CFG80211_MAX_SCAN_REQUESTS=4

# ESP32 WiFi driver
CONFIG_ESP32_WIFI=y
CONFIG_ESP32_WIFI_SDIO=y
CONFIG_ESP32_WIFI_SPI=n
CONFIG_ESP32_WIFI_STA=y
CONFIG_ESP32_WIFI_AP=n
CONFIG_ESP32_WIFI_RESET_GPIO=-1
CONFIG_ESP32_WIFI_NINTERFACES=2
CONFIG_ESP32_WIFI_RX_BUFFER_SIZE=2048

# Debug
CONFIG_DEBUG_WIRELESS_INFO=y
CONFIG_DEBUG_WIRELESS_ERROR=y

# Filesystem
CONFIG_FS_PROCFS=y
CONFIG_FS_TMPFS=y

# Disable unused features to speed up compilation
# CONFIG_NSH_LIBRARY is not set
# CONFIG_ARCH_FPU is not set
